# Copy this file to .env and fill in values as needed.
# All variables have sane defaults except OPENAI_API_KEY.

# --- Transcription provider -------------------------------------------------

# Which transcription backend to use. Only "openai" is implemented in v0.1.
TRANSCRIPTION_PROVIDER=openai

# Model name passed to the transcription provider.
TRANSCRIPTION_MODEL=whisper-1

# Required when TRANSCRIPTION_PROVIDER=openai. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Override if you proxy or self-host an OpenAI-compatible transcription API.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vision (opt-in visual understanding, off by default) --------------------
# Adds meaningful visual observations (on-screen text, slides, UI, charts)
# alongside the spoken transcript. Every existing behavior is unchanged when
# this is off — no frame sampling, no vision API calls, no extra latency/cost.

VISION_ENABLED=false

# Only "openai" is implemented today. Reuses OPENAI_API_KEY/OPENAI_BASE_URL above.
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o-mini

# Hard cap on frames sampled per video — this is what keeps video length from
# producing unbounded vision-model calls, regardless of duration.
MAX_FRAMES_PER_VIDEO=16

# How far apart (in seconds) sampled frames are, up to the cap above.
FRAME_SAMPLE_INTERVAL_SECONDS=5

# Hard cap on the single batched vision API call, in seconds.
VISION_TIMEOUT_SECONDS=45

# --- Video Map (opt-in, off by default, requires VISION_ENABLED=true) --------
# Resolves "this"/"that"/pointing references (e.g. "this one is incredible")
# to a specific visual entity, and models what the person visibly DID
# (points_at, shows, holds, ...). Off by default — no effect on existing
# transcribe_video/understand_video behavior when disabled.

VIDEO_MAP_ENABLED=false

# Reuses OPENAI_API_KEY/OPENAI_BASE_URL above.
VIDEO_MAP_MODEL=gpt-4o-mini
VIDEO_MAP_TIMEOUT_SECONDS=45

# Hard cap on how many "this"/"that"/topic-word moments get targeted analysis
# per video — this is what keeps cost bounded regardless of transcript length.
VIDEO_MAP_MAX_WINDOWS=8

# --- Semantic search (opt-in, off by default) --------------------------------
# Adds OpenAI embeddings on top of lexical search_video/find_moment matching,
# so a query like "cost" can also surface on-screen text that says "pricing".
# Off by default — search stays lexical-only, exactly as before this existed.

SEARCH_EMBEDDINGS_ENABLED=false

# Reuses OPENAI_API_KEY/OPENAI_BASE_URL above.
SEARCH_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_EMBEDDING_TIMEOUT_SECONDS=20

# --- Media limits ------------------------------------------------------------

# Maximum downloaded media size, in megabytes. Larger media is rejected
# with MEDIA_TOO_LARGE.
MAX_VIDEO_SIZE_MB=100

# Maximum video/audio duration, in seconds. Longer media is rejected with
# MEDIA_TOO_LONG.
MAX_VIDEO_DURATION_SECONDS=600

# --- Timeouts ----------------------------------------------------------------

# Hard cap on the entire transcribe_video request, in seconds.
REQUEST_TIMEOUT_SECONDS=60

# Hard cap on downloading the source media, in seconds.
DOWNLOAD_TIMEOUT_SECONDS=30

# Hard cap on the transcription API call, in seconds.
TRANSCRIPTION_TIMEOUT_SECONDS=45

# --- Concurrency / backpressure ----------------------------------------------

# Maximum number of transcribe_video requests processed at once. Requests
# beyond this fail fast with RATE_LIMITED instead of queuing unboundedly.
MAX_CONCURRENT_REQUESTS=4

# --- Cache ---------------------------------------------------------------------

# Enable the in-memory transcript cache (keyed by normalized Reel URL).
CACHE_ENABLED=true

# How long a cached transcript stays valid, in seconds.
CACHE_TTL_SECONDS=3600

# Maximum number of cached transcripts kept in memory (oldest evicted first).
CACHE_MAX_ENTRIES=200

# --- External binaries ---------------------------------------------------------

# Path to the yt-dlp executable used to resolve public Instagram Reel media.
YTDLP_PATH=yt-dlp

# Path to the ffmpeg executable used for audio extraction.
FFMPEG_PATH=ffmpeg

# --- Observability ---------------------------------------------------------------

# Log level for structured (pino) logs written to stderr.
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- Working storage -----------------------------------------------------------

# Base directory for per-request temporary workspaces. Defaults to the OS
# temp directory when unset. Each request gets its own subdirectory, always
# removed when the request finishes.
TEMP_DIR=

# --- HTTP server -----------------------------------------------------------

HTTP_PORT=8080
HTTP_HOST=0.0.0.0

# How long graceful shutdown waits for in-flight requests to finish before
# force-exiting, in seconds.
SHUTDOWN_TIMEOUT_SECONDS=30

# --- Instagram provider protection ------------------------------------------
# Never used to evade Instagram's own limits/detection — only to bound how
# hard Moreel is willing to hit Instagram, and to back off when it's failing.

INSTAGRAM_MAX_CONCURRENCY=4
INSTAGRAM_REQUESTS_PER_SECOND=2
INSTAGRAM_COOLDOWN_SECONDS=60
INSTAGRAM_MAX_RETRIES=3
INSTAGRAM_CIRCUIT_FAILURE_THRESHOLD=5

# Kill switch: disables Instagram retrieval without touching MCP, auth,
# billing, or any other provider.
INSTAGRAM_DISABLED=false

# --- Redis (distributed rate limiting / circuit state / dedup) -------------
# Optional in development — falls back to in-memory, single-replica-only
# behavior when unset.

REDIS_URL=

RATE_LIMIT_ANONYMOUS_RPM=5
RATE_LIMIT_FREE_RPM=5

# --- Postgres (accounts, API keys — never media) ---------------------------
# Optional in development — auth middleware is disabled when unset, and the
# app runs without authentication.

DATABASE_URL=
DB_POOL_MAX=10
